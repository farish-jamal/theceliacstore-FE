'use client'
import { useAppSelector } from '@/app/hooks/reduxHooks'

const WAIcon = () => (
  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
    <path d="M12 0C5.373 0 0 5.373 0 12c0 2.126.556 4.121 1.527 5.847L.057 23.998l6.304-1.654A11.954 11.954 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.002-1.366l-.358-.213-3.743.981 1-3.645-.234-.374A9.817 9.817 0 012.182 12C2.182 6.57 6.57 2.182 12 2.182S21.818 6.57 21.818 12 17.43 21.818 12 21.818z"/>
  </svg>
)

export default function WhatsAppStrip() {
  const guestCart = useAppSelector((state) => state.guestCart.cart)
  const cartItems = guestCart?.items ?? []

  if (!cartItems || cartItems.length === 0) return null

  const total = cartItems.reduce((sum: number, item) => sum + (item.price * (item.quantity ?? 1)), 0)
  const names = cartItems.slice(0, 2).map((i) => i.product?.name ?? '').join(', ')
  const count = cartItems.reduce((sum: number, item) => sum + (item.quantity ?? 1), 0)

  const message = encodeURIComponent(
    `Hi, I'd like to order from The Celiac Store:\n` +
    cartItems.map((item) => `${item.quantity ?? 1}x ${item.product?.name ?? ''} - \u20B9${item.price}`).join('\n') +
    `\n\nTotal: \u20B9${total}\nPlease confirm availability and delivery.`
  )

  return (
    <div className="fixed bottom-16 left-0 right-0 z-40 bg-[#eaf6f0] border-t border-[#95d5b2] px-4 py-2 flex items-center justify-between gap-3">
      <p className="text-xs text-[#1b4332] truncate">
        <span className="font-medium">{count} item{count > 1 ? 's' : ''} in cart</span>
        {' \u00B7 '}{names}{' \u00B7 '}{'\u20B9'}{total}
      </p>
      <a
        href={`https://wa.me/919810107887?text=${message}`}
        target="_blank"
        rel="noopener noreferrer"
        className="flex items-center gap-1.5 bg-[#25D366] text-white text-xs px-3 py-1.5 rounded-lg whitespace-nowrap flex-shrink-0"
      >
        <WAIcon /> Send cart to WhatsApp
      </a>
    </div>
  )
}
